{
  "manifest_version": 3,
  "name": "Swag Bot",
  "version": "0.1.0",
  "description": "Give tasks to Swag Bot on your computer. Watch the plan, approve actions, and share the current page.",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_title": "Open Swag Bot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "nativeMessaging", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
