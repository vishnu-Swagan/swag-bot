{
  "name": "swag-bot",
  "version": "0.2.0",
  "description": "Hand long, checkable tasks to Swag Bot over MCP.",
  "mcpServers": {
    "swag": {
      "command": "uvx",
      "args": [
        "--from",
        "swag-bot[mcp] @ git+https://github.com/vishnu-Swagan/swag-bot",
        "swag-bot",
        "serve-mcp"
      ]
    }
  }
}
