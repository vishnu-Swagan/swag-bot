# Placeholder keys only. Copy to .env if you want a local reminder of which
# variables exist. Swag Bot does not load this file; export the variables
# into the process environment yourself. Never commit real keys.
# .gitignore ignores .env and does not ignore this example.

# Config directory. Default is ~/.swag (config.toml lives inside it).
# SWAG_HOME=

# Bring-your-own-key providers. Leave unset to use local Ollama.
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here
OPENROUTER_API_KEY=your-openrouter-key-here

# Ollama's local HTTP endpoint. No key.
OLLAMA_HOST=http://127.0.0.1:11434
